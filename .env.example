# Google AI Studio / Gemma 4 Configuration (Nera Recovery Consultant)
GOOGLE_AI_STUDIO_API_KEY=""
GEMMA_MODEL="gemma-4-26b-a4b-it"

# Database Connection (Postgres). The API keeps email import data here (nera_* tables);
# without it, it falls back to an in-memory store for local development.
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require"

# MAIA Router (OpenAI-compatible gateway)
MAIA_API_KEY=""
MAIA_BASE_URL="https://api.maiarouter.ai/v1"
# provider-prefixed model id; list them with GET $MAIA_BASE_URL/models
MAIA_MODEL="xai/grok-4-1-fast-non-reasoning"

# Shared API Secret
SHARED_API_KEY="nera-bni-hackathon-secret-key"

# API Port & Configuration
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Sign-in session cookie (HMAC). 32+ chars: openssl rand -hex 32
SESSION_SECRET=""

# Email import (transaction history from receipts)
# Web app URL, used to return from the Gmail OAuth flow
WEB_APP_URL="http://localhost:3000"
# 32 random bytes, base64. Encrypts Gmail refresh tokens and signs OAuth state: openssl rand -base64 32
EMAIL_TOKEN_KEY=""
# Option A: Gmail API (OAuth client of type "Web application", scope gmail.readonly)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/email/gmail/callback"
# Real-time Gmail sync: Pub/Sub topic Gmail publishes to (projects/<id>/topics/<name>),
# and the secret in the push subscription URL (.../api/email/gmail/push?token=...)
GMAIL_PUBSUB_TOPIC=""
GMAIL_PUSH_TOKEN=""
# fallback polling interval in minutes (0 disables)
GMAIL_POLL_MINUTES="10"
# Option B: forwarding address. Mail for *@INBOUND_EMAIL_DOMAIN arrives either through
# the built-in SMTP server (MX record -> this host, SMTP_PORT) or through
# Cloudflare Email Routing -> apps/api/inbound-worker -> /api/email/inbound.
INBOUND_EMAIL_DOMAIN="inbox.nera.id"
INBOUND_WEBHOOK_SECRET=""
SMTP_PORT=""
SMTP_HOSTNAME=""
# directory with privkey.pem + fullchain.pem for STARTTLS (optional)
SMTP_TLS_DIR=""
# optional JSON file that persists the email import store across restarts
EMAIL_STORE_FILE=""

# Admin dashboard (/admin): comma-separated Google emails
ADMIN_EMAILS=""

# Deploy only (deploy/deploy.sh reads these from .env.deploy on the server)
PUBLIC_URL="https://nera.example.com"
MAIL_HOST="nera.example.com"
NERA_DB_PASSWORD=""
