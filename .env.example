# Database Connection (Neon Postgres)
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require"

# MAIA Router (OpenAI-compatible gateway)
MAIA_API_KEY=""
MAIA_BASE_URL="https://router.maia.id/v1"

# Shared API Secret
SHARED_API_KEY="nera-bni-hackathon-secret-key"

# API Port & Configuration
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Email import (transaction history from receipts)
# Web app URL, used to return from the Gmail OAuth flow
WEB_APP_URL="http://localhost:3000"
# 32 random bytes, base64. Encrypts Gmail refresh tokens and signs OAuth state: openssl rand -base64 32
EMAIL_TOKEN_KEY=""
# Option A: Gmail API (OAuth client of type "Web application", scope gmail.readonly)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/email/gmail/callback"
# Option B: forwarding address (Cloudflare Email Routing -> apps/api/inbound-worker)
INBOUND_EMAIL_DOMAIN="inbox.nera.id"
INBOUND_WEBHOOK_SECRET=""
